# Flutter talks only to the authenticated NestJS backend.
# Never add OPENAI_API_KEY, LIVEKIT_API_SECRET, or PIPECAT_INTERNAL_API_KEY here.

# Android emulator:
API_BASE_URL=http://10.0.2.2:5000

# Physical phone on the same Wi-Fi (replace with your computer IPv4):
# API_BASE_URL=http://192.168.0.105:5000

# iOS simulator / desktop app:
# API_BASE_URL=http://127.0.0.1:5000

# Production later:
# API_BASE_URL=https://your-main-backend-domain.example
