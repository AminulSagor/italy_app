<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Flutter tooling and local NestJS/LiveKit development. -->
    <uses-permission android:name="android.permission.INTERNET"/>

    <!-- Debug only. Production should use HTTPS/WSS and keeps this disabled. -->
    <application android:usesCleartextTraffic="true">
        <!--
          The supplied gphone64 x86_64 log loses the entire ADB device while
          using the Impeller OpenGLES backend, without a Dart or Android fatal
          exception. Keep release builds on Flutter defaults, but use Skia for
          debug/emulator runs to avoid host GPU/Impeller AVD instability.
        -->
        <meta-data
            android:name="io.flutter.embedding.android.EnableImpeller"
            android:value="false"/>
    </application>
</manifest>
